{
  "name": "tudooo",
  "displayName": "tudooo",
  "description": "Find and manage forgotten TODO, FIXME, HACK, and XXX comments in your workspace.",
  "icon": "images/icon.png",
  "version": "0.1.2",
  "publisher": "mudassarsindoli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mudassarsindoli/tudooo.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "fixme",
    "hack",
    "tracker",
    "comments"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tudooo",
          "title": "TODO Tracker",
          "icon": "media/tudooo.svg"
        }
      ]
    },
    "views": {
      "tudooo": [
        {
          "id": "tudooo.tracker",
          "name": "TODO Tracker",
          "icon": "media/tudooo.svg",
          "contextualTitle": "TODO Tracker"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tudooo.tracker",
        "contents": "No tracked comments yet.\n[Scan Workspace](command:tudooo.scanWorkspace)"
      }
    ],
    "commands": [
      {
        "command": "tudooo.refresh",
        "title": "Refresh",
        "category": "tudooo",
        "icon": "$(refresh)"
      },
      {
        "command": "tudooo.scanWorkspace",
        "title": "Scan Workspace",
        "category": "tudooo",
        "icon": "$(search)"
      },
      {
        "command": "tudooo.hideItem",
        "title": "Clear/Hide resolved item",
        "category": "tudooo",
        "icon": "$(close)"
      },
      {
        "command": "tudooo.filter",
        "title": "Filter comments",
        "category": "tudooo",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tudooo.refresh",
          "when": "view == tudooo.tracker",
          "group": "navigation@1"
        },
        {
          "command": "tudooo.scanWorkspace",
          "when": "view == tudooo.tracker",
          "group": "navigation@2"
        },
        {
          "command": "tudooo.filter",
          "when": "view == tudooo.tracker",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "tudooo.hideItem",
          "when": "view == tudooo.tracker && viewItem == todoItem",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "tudooo.hideItem",
          "when": "view == tudooo.tracker"
        }
      ]
    },
    "configuration": {
      "title": "tudooo",
      "properties": {
        "tudooo.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Skip files larger than this many bytes while scanning."
        }
      }
    },
    "colors": [
      {
        "id": "tudooo.todoForeground",
        "description": "Color used to highlight TODO comments.",
        "defaults": {
          "dark": "#FFD54A",
          "light": "#8A6D00",
          "highContrast": "#FFD54A",
          "highContrastLight": "#6B5400"
        }
      },
      {
        "id": "tudooo.fixmeForeground",
        "description": "Color used to highlight FIXME comments.",
        "defaults": {
          "dark": "#2DD4D4",
          "light": "#00828F",
          "highContrast": "#2DD4D4",
          "highContrastLight": "#005B64"
        }
      },
      {
        "id": "tudooo.hackForeground",
        "description": "Color used to highlight HACK comments.",
        "defaults": {
          "dark": "#4FA3FF",
          "light": "#0B5FC9",
          "highContrast": "#4FA3FF",
          "highContrastLight": "#063C85"
        }
      },
      {
        "id": "tudooo.xxxForeground",
        "description": "Color used to highlight XXX comments.",
        "defaults": {
          "dark": "#FF5C5C",
          "light": "#C62828",
          "highContrast": "#FF5C5C",
          "highContrastLight": "#8E0000"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test out/parser.test.js out/age.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
